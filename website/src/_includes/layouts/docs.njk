---
layout: layouts/base.njk
---
{% set langPrefix = "/" + lang if lang and lang != defaultLanguage else "" %}
{% set relatedText = i18n[lang or defaultLanguage].docs.related %}
<button class="docs-menu-toggle" id="docs-menu-toggle" aria-label="{{ 'docs.menuLabel' | t(lang) | default('Documentation menu') }}" aria-controls="docs-sidebar" aria-expanded="false">
  <span aria-hidden="true">☰</span> {{ "docs.title" | t(lang) | default("Documentation") }}
</button>
<div class="docs-layout">
  {% include "partials/docs-sidebar.njk" %}
  <article class="prose">
    {{ content | safe }}

    <section class="related-panel">
      <h2>{{ relatedText.title }}</h2>
      <div class="related-grid">
        <a href="{{ langPrefix }}/docs/architecture/">
          <span>{{ relatedText.architectureKicker }}</span>
          <strong>{{ relatedText.architectureTitle }}</strong>
          <small>{{ relatedText.architectureDescription }}</small>
        </a>
        <a href="{{ langPrefix }}/docs/editors/">
          <span>{{ relatedText.setupKicker }}</span>
          <strong>{{ relatedText.setupTitle }}</strong>
          <small>{{ relatedText.setupDescription }}</small>
        </a>
      </div>
    </section>
  </article>
</div>
