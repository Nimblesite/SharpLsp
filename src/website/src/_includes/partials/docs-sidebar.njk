{# Implements [WEB-DESIGN-DOCS-NAV]: the docs grouped by what a reader is doing, contributor pages folded away last. #}
{% set langPrefix = "/" + lang if lang and lang != defaultLanguage else "" %}
{% set docsText = i18n[lang or defaultLanguage].docs %}
{% set docsRoot = langPrefix + "/docs/" %}
{% set here = page.url.slice(docsRoot.length) if page.url.startsWith(docsRoot) else none %}
<nav class="sidebar" id="docs-sidebar" aria-label="{{ docsText.title }}">
  {% for group in navigation.docs %}
  {% set links %}
    <ul>
      {% for slug, key in group.pages %}
      <li><a href="{{ docsRoot + slug }}"{% if slug == here %} class="active" aria-current="page"{% endif %}>{{ docsText[key] }}</a></li>
      {% endfor %}
    </ul>
  {% endset %}
  {% if group.secondary %}
  <details{% if here in group.pages %} open{% endif %}>
    <summary>{{ docsText.groups[group.group] }}</summary>
    {{ links | safe }}
  </details>
  {% else %}
  <h2>{{ docsText.groups[group.group] }}</h2>
  {{ links | safe }}
  {% endif %}
  {% endfor %}
</nav>
