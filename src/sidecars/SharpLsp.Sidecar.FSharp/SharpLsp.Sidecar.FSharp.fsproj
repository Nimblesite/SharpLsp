<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sharplsp-sidecar-fsharp</ToolCommandName>
    <PackageId>SharpLsp.Sidecar.FSharp</PackageId>
    <Authors>SharpLsp contributors</Authors>
    <Description>SharpLsp F# language sidecar — FSharp.Compiler.Service-backed semantic analysis for the SharpLsp server.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Nimblesite/SharpLsp</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Nimblesite/SharpLsp</PackageProjectUrl>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <!-- Override Directory.Build.props: F# compiler doesn't support WarningLevel 9999 -->
    <WarningLevel>5</WarningLevel>
    <!-- Override C#-specific analyzers that don't apply to F# -->
    <EnforceExtendedAnalyzerRules>false</EnforceExtendedAnalyzerRules>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpLsp.Sidecar.Common\SharpLsp.Sidecar.Common.csproj" />
    <ProjectReference Include="../../../third_party/FSharpLint.Core/FSharpLint.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpLsp.Sidecar.FSharp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- FCS script resolution needs the actual SDK's interactive settings assembly. -->
    <Reference Include="FSharp.Compiler.Interactive.Settings">
      <HintPath>$(MSBuildToolsPath)/FSharp/FSharp.Compiler.Interactive.Settings.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.403" />
    <PackageReference Include="FSharp.Compiler.Service" Version="43.12.403" />
    <!-- Roslyn compiles the C# projects an F# project references, in memory, so the
         sidecar ships it like the C# sidecar does: restore full asset flow.
         [SHARPLSP-ARCHITECTURE-PROJECTS-FSHARP-CSHARP-REFERENCES] -->
    <PackageReference Update="Microsoft.CodeAnalysis.CSharp" PrivateAssets="none" />
    <PackageReference Include="Fantomas.Core" Version="8.1.0" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <!-- Override transitive 9.0.0 from FSharpLint.Core/Microsoft.Build chain (GHSA-37gx-xxp4-5rgx, GHSA-w3x6-4m5h-cxqf, fixed in 9.0.15; GHSA-r955-8q5j-3h83, GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj, fixed in 10.0.13). -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Hover/FSharpHoverBuilder.fs" />
    <Compile Include="FSharpAssets.fs" />
    <Compile Include="FSharpMetadataNavigator.fs" />
    <Compile Include="FSharpWorkspaceRuntime.fs" />
    <Compile Include="FSharpScriptSource.fs" />
    <Compile Include="FSharpProjectLoading.fs" />
    <Compile Include="FSharpDesignTime.fs" />
    <Compile Include="FSharpCSharpReferences.fs" />
    <Compile Include="FSharpProjectGraph.fs" />
    <Compile Include="FSharpSemanticNavigation.fs" />
    <Compile Include="FSharpWorkspace.fs" />
    <Compile Include="FSharpOwningEpoch.fs" />
    <Compile Include="FSharpWorkspaceLoading.fs" />
    <Compile Include="FSharpDiagnosticInputs.fs" />
    <Compile Include="FSharpDocuments.fs" />
    <Compile Include="FSharpOwningProject.fs" />
    <Compile Include="FSharpTargetFrameworks.fs" />
    <Compile Include="FSharpPackages.fs" />
    <Compile Include="FSharpRenameToken.fs" />
    <Compile Include="FSharpReferences.fs" />
    <Compile Include="FSharpForeignSymbols.fs" />
    <Compile Include="FSharpFeatures.fs" />
    <Compile Include="FSharpFileOrder.fs" />
    <Compile Include="FSharpLocalAnalysis.fs" />
    <Compile Include="FSharpCodeActions.fs" />
    <Compile Include="FSharpPipeRefactoring.fs" />
    <Compile Include="FSharpNameFixes.fs" />
    <Compile Include="FSharpCodeFixes.fs" />
    <Compile Include="FSharpCompletion.fs" />
    <Compile Include="FSharpRenameAliases.fs" />
    <Compile Include="FSharpRenameIndexers.fs" />
    <Compile Include="FSharpRename.fs" />
    <Compile Include="FSharpCodeLens.fs" />
    <Compile Include="FSharpHierarchy.fs" />
    <Compile Include="FSharpSymbols.fs" />
    <Compile Include="FSharpSignature.fs" />
    <Compile Include="FSharpWire.fs" />
    <Compile Include="FSharpProjectDiagnostics.fs" />
    <Compile Include="FSharpAnalyzers.fs" />
    <Compile Include="FSharpLintDiagnostics.fs" />
    <Compile Include="FSharpDiagnosticQueries.fs" />
    <Compile Include="FSharpSidecar.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
