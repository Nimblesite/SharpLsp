<idea-plugin>
    <id>com.sharplsp.rider</id>
    <name>SharpLsp LSP</name>
    <vendor url="https://github.com/Nimblesite/sharplsp">SharpLsp LSP</vendor>

    <!-- Required for every plugin that uses the IntelliJ Platform APIs. -->
    <depends>com.intellij.modules.platform</depends>

    <!-- LSP API is gated behind this module. It ships in Rider, IntelliJ
         Ultimate, WebStorm, PhpStorm, PyCharm Professional, etc.
         Declaring this dependency makes the plugin refuse to load on
         IntelliJ Community and Android Studio, which is the correct
         behaviour — those editions have no LSP support. -->
    <depends>com.intellij.modules.lsp</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- LSP server registration — extension point lives in the
             com.intellij.modules.lsp module. -->
        <platform.lsp.serverSupportProvider implementation="com.sharplsp.rider.lsp.SharpLspServerSupportProvider" />

        <!-- Solution Explorer tool window. Anchored to the left so it
             sits next to Rider's built-in Solution Explorer. -->
        <toolWindow
            id="SharpLsp Solution"
            anchor="left"
            icon="/icons/sharplsp.svg"
            factoryClass="com.sharplsp.rider.toolwindow.SharpLspSolutionToolWindowFactory"
        />

        <!-- NuGet Package Browser tool window. Anchored to the bottom
             so it doesn't fight with the solution tree. -->
        <toolWindow
            id="SharpLsp NuGet"
            anchor="bottom"
            icon="/icons/sharplsp.svg"
            factoryClass="com.sharplsp.rider.toolwindow.nuget.SharpLspNuGetToolWindowFactory"
        />

        <!-- Notification group used by every SharpLsp action. Must be
             registered so user toasts for install/uninstall/restore
             actually surface. -->
        <notificationGroup id="SharpLsp" displayType="BALLOON" />

        <!-- Project-level settings UI at Settings → Tools → SharpLsp. -->
        <projectConfigurable
            parentId="tools"
            id="com.sharplsp.rider.settings"
            displayName="SharpLsp"
            instance="com.sharplsp.rider.settings.SharpLspSettingsConfigurable"
        />

        <projectService serviceImplementation="com.sharplsp.rider.settings.SharpLspSettings" />
    </extensions>
</idea-plugin>
